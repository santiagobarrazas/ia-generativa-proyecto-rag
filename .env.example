# Copia este archivo a .env y cambia los valores. Genera secretos con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
BYOK_KEY=cambia-esto-por-otro-secreto-largo-de-al-menos-32-caracteres
POSTGRES_PASSWORD=rag

# Modelo de embeddings (se llama con la misma API key que eliges en la app).
# Si lo cambias, borra el volumen de Qdrant: los vectores viejos tendrían otra dimensión.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
